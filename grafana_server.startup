# 1. 設定 Management VLAN 的固定 IP 與內部網段路由
ip addr add 192.168.1.30/24 dev eth0
ip link set up dev eth0
ip route add 192.168.10.0/24 via 192.168.1.1
ip route add 192.168.20.0/24 via 192.168.1.1

# 2. 建立持久化資料夾並啟動 Grafana (Port 3000)
mkdir -p /shared/grafana-data
export GF_PATHS_DATA=/shared/grafana-data
/usr/sbin/grafana-server --homepath /usr/share/grafana --config /etc/grafana/grafana.ini web &