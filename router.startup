ip addr add 192.168.1.1/24 dev eth0
ip link set up dev eth0
ip addr add 192.168.10.1/24 dev eth1
ip link set up dev eth1
ip addr add 192.168.20.1/24 dev eth2
ip link set up dev eth2
sysctl -w net.ipv4.ip_forward=1

# 啟動 DHCP 伺服器並綁定所有 MAC 租約
dnsmasq \
  --interface=eth1 --dhcp-range=192.168.10.50,192.168.10.100,255.255.255.0,12h \
  --dhcp-host=02:42:c0:a8:0a:11,192.168.10.11,temp_sensor \
  --dhcp-host=02:42:c0:a8:0a:12,192.168.10.12,co_sensor \
  --dhcp-host=02:42:c0:a8:0a:13,192.168.10.13,h2_sensor \
  --dhcp-host=02:42:c0:a8:0a:14,192.168.10.14,hf_sensor \
  --dhcp-host=02:42:c0:a8:0a:15,192.168.10.15,smoke_sensor \
  --interface=eth2 --dhcp-range=192.168.20.50,192.168.20.100,255.255.255.0,12h \
  --dhcp-host=02:42:c0:a8:14:11,192.168.20.11,voltage_sensor \
  --dhcp-host=02:42:c0:a8:14:12,192.168.20.12,vibration_sensor \
  --dhcp-host=02:42:c0:a8:14:13,192.168.20.13,weight_sensor \
  --dhcp-host=02:42:c0:a8:14:14,192.168.20.14,magnetic_sensor \
  --dhcp-host=02:42:c0:a8:14:15,192.168.20.15,vision_sensor \
  --bind-interfaces