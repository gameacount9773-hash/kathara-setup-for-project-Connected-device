# ==========================================
# 1. Interface & Subnet Configuration
# ==========================================
ip addr add 192.168.1.1/24 dev eth0
ip link set up dev eth0
ip addr add 192.168.10.1/24 dev eth1
ip link set up dev eth1
ip addr add 192.168.20.1/24 dev eth2
ip link set up dev eth2

# ==========================================
# 2. Firewall Configuration (iptables)
# ==========================================
# Clear existing rules
iptables -F
iptables -X

# A. Set default FORWARD policy to DROP (block all unapproved traffic by default)
iptables -P FORWARD DROP

# B. Allow established and related return traffic (stateful inspection)
iptables -A FORWARD -m state --state ESTABLISHED,RELATED -j ACCEPT

# C. Whitelist 1: Allow Management VLAN (eth0) to access all zones (admin privilege)
iptables -A FORWARD -i eth0 -j ACCEPT

# D. Whitelist 2: Allow Safety VLAN (eth1) to reach Gateway MQTT broker (Port 1883)
iptables -A FORWARD -i eth1 -d 192.168.1.10 -p tcp --dport 1883 -j ACCEPT

# E. Whitelist 3: Allow Sorting VLAN (eth2) to reach Gateway MQTT broker (Port 1883)
iptables -A FORWARD -i eth2 -d 192.168.1.10 -p tcp --dport 1883 -j ACCEPT

# ==========================================
# 3. DHCP Server & Static MAC Reservations
# ==========================================
# Start dnsmasq and bind fixed IPs to authorized sensor MAC addresses
dnsmasq \
  --interface=eth1 --dhcp-range=192.168.10.50,192.168.10.100,255.255.255.0,12h \
  --dhcp-host=02:42:c0:a8:0a:11,192.168.10.11,temp_sensor \
  --dhcp-host=02:42:c0:a8:0a:12,192.168.10.12,co_sensor \
  --dhcp-host=02:42:c0:a8:0a:13,192.168.10.13,h2_sensor \
  --dhcp-host=02:42:c0:a8:0a:14,192.168.10.14,hf_sensor \
  --dhcp-host=02:42:c0:a8:0a:15,192.168.10.15,smoke_sensor \
  --interface=eth2 --dhcp-range=192.168.20.50,192.168.20.100,255.255.255.0,12h \
  --dhcp-host=02:42:c0:a8:14:11,192.168.20.11,voltage_sensor \
  --dhcp-host=02:42:c0:a8:14:12,192.168.20.12,vibration_sensor \
  --dhcp-host=02:42:c0:a8:14:13,192.168.20.13,weight_sensor \
  --dhcp-host=02:42:c0:a8:14:14,192.168.20.14,magnetic_sensor \
  --dhcp-host=02:42:c0:a8:14:15,192.168.20.15,vision_sensor \
  --dhcp-host=02:42:c0:a8:14:16,192.168.20.16,vision_edge_pc \
  --bind-interfaces