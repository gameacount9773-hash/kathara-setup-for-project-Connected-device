# 1. 設定 Management VLAN 的固定 IP 與內部網段路由
ip addr add 192.168.1.10/24 dev eth0
ip link set up dev eth0
ip route add 192.168.10.0/24 via 192.168.1.1
ip route add 192.168.20.0/24 via 192.168.1.1

# ==========================================
# 2. 啟動 MQTT Broker (Mosquitto)
# ==========================================
# 建立缺少的 pid 資料夾並設定擁有者
mkdir -p /run/mosquitto
chown mosquitto:mosquitto /run/mosquitto

echo "allow_anonymous true" > /etc/mosquitto/mosquitto.conf
echo "listener 1883 0.0.0.0" >> /etc/mosquitto/mosquitto.conf

# 現在啟動就不會報錯了
service mosquitto start

# ==========================================
# 3. 啟動 n8n (指定持久化資料夾)
# ==========================================
# 在 shared 裡建立專屬資料夾來放 n8n 的設定與 Workflows
mkdir -p /shared/n8n-data

# 設定環境變數讓 n8n 把資料存在 shared 資料夾，並關閉不必要的 telemetry
export N8N_USER_FOLDER="/shared/n8n-data"
export N8N_DIAGNOSTICS_ENABLED=false
export N8N_PERSONALIZATION_ENABLED=false

# 啟動 n8n
n8n start &