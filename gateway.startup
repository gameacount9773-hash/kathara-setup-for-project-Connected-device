
#!/bin/bash

# ==========================================
# 1. Setup Management VLAN static IP
# ==========================================

ip addr add 192.168.1.10/24 dev eth0
ip link set up dev eth0

ip route add 192.168.10.0/24 via 192.168.1.1
ip route add 192.168.20.0/24 via 192.168.1.1


# ==========================================
# 2. MQTT Firewall Rate Limiting
# ==========================================

# Install iptables
apt-get update
apt-get install -y iptables

# Prevent duplicate firewall rules
iptables -C INPUT \
-p tcp --dport 1883 \
-m conntrack --ctstate NEW \
-m hashlimit \
--hashlimit-above 6/minute \
--hashlimit-burst 3 \
--hashlimit-mode srcip \
--hashlimit-name mqtt_bruteforce \
-j DROP 2>/dev/null || \

iptables -I INPUT 1 \
-p tcp --dport 1883 \
-m conntrack --ctstate NEW \
-m hashlimit \
--hashlimit-above 6/minute \
--hashlimit-burst 3 \
--hashlimit-mode srcip \
--hashlimit-name mqtt_bruteforce \
-j DROP

echo "MQTT connection rate limiting enabled"


# ==========================================
# 3. Start MQTT Broker (Mosquitto)
# ==========================================

mkdir -p /run/mosquitto
chown mosquitto:mosquitto /run/mosquitto

# Create MQTT password file
mosquitto_passwd -b -c /etc/mosquitto/passwd iotuser 'YourStrongPassword'

# Set password file permissions
chown mosquitto:mosquitto /etc/mosquitto/passwd
chmod 600 /etc/mosquitto/passwd

# Configure Mosquitto
cat > /etc/mosquitto/mosquitto.conf <<'EOF'
listener 1883 0.0.0.0
allow_anonymous false
password_file /etc/mosquitto/passwd
EOF

# Start MQTT broker
service mosquitto start

echo "MQTT broker started with authentication and firewall protection"
