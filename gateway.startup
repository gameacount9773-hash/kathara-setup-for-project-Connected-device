# 1. 設定 Management VLAN 的固定 IP 與內部網段路由
ip addr add 192.168.1.10/24 dev eth0
ip link set up dev eth0
ip route add 192.168.10.0/24 via 192.168.1.1
ip route add 192.168.20.0/24 via 192.168.1.1

# ==========================================
# 2. 啟動 MQTT Broker (Mosquitto)
# ==========================================
# 建立缺少的 pid 資料夾並設定擁有者
mkdir -p /run/mosquitto
chown mosquitto:mosquitto /run/mosquitto

echo "allow_anonymous true" > /etc/mosquitto/mosquitto.conf
echo "listener 1883 0.0.0.0" >> /etc/mosquitto/mosquitto.conf

# 現在啟動就不會報錯了
service mosquitto start

# ==========================================
# 3. 啟動 n8n (指定持久化資料夾)
# ==========================================
# 在 shared 裡建立專屬資料夾來放 n8n 的設定與 Workflows
mkdir -p /shared/n8n-data

export N8N_USER_FOLDER="/shared/n8n-data"
export N8N_DIAGNOSTICS_ENABLED=false
export N8N_PERSONALIZATION_ENABLED=false
export N8N_LISTEN_ADDRESS="0.0.0.0"  # <- 補上這一行

if [ ! -f "/shared/n8n-data/database.sqlite" ] && [ -f "/shared/flow.json" ]; then
    echo "匯入初始 Workflow..."
    n8n import:workflow --input=/shared/flow.json
    
    # 強制將所有匯入的 Workflow 狀態設為 Active (Published)
    n8n update:workflow --all --active=true
fi

n8n start &

# ==========================================
# 4. 自動註冊 n8n Owner 帳號 (防呆自動化)
# ==========================================
(
  # 每兩秒戳一次 5678 port，直到有回應代表 n8n 開機完畢
  while ! curl -s http://localhost:5678 > /dev/null; do
    sleep 2
  done
  
  # 呼叫 n8n 內部 API，自動填入帳號密碼並建立 Owner
  curl -s -X POST http://localhost:5678/rest/owner/setup \
       -H "Content-Type: application/json" \
       -d '{"email":"admin@local.test","firstName":"IoT","lastName":"Admin","password":"Admin1234"}'
) &