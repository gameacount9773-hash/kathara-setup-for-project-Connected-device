      "panel-3": {
        "kind": "Panel",
        "spec": {
          "id": 3,
          "title": "Offline sensors",
          "description": "ensors that sent nothing for more than 3× their send interval. A silent sensor can hide a real danger.",
          "links": [],
          "data": {
            "kind": "QueryGroup",
            "spec": {
              "queries": [
                {
                  "kind": "PanelQuery",
                  "spec": {
                    "query": {
                      "kind": "DataQuery",
                      "group": "grafana-postgresql-datasource",
                      "version": "v0",
                      "datasource": {
                        "name": "factory-postgres-ds"
                      },
                      "spec": {
                        "dataset": "factory_db",
                        "editorMode": "code",
                        "format": "table",
                        "rawQuery": true,
                        "rawSql": "SELECT sensor.name AS sensor, max(measurement.time) AS last_reading\r\nFROM sensor\r\nJOIN sensor_type      ON sensor_type.type_id      = sensor.type_id\r\nLEFT JOIN measurement ON measurement.sensor_id    = sensor.sensor_id\r\nGROUP BY sensor.name, sensor_type.send_interval_s\r\nHAVING max(measurement.time) IS NULL\r\n    OR max(measurement.time) < now() - 3 * sensor_type.send_interval_s * interval '1 second'",
                        "sql": {
                          "columns": [
                            {
                              "parameters": [],
                              "type": "function"
                            }
                          ],
                          "groupBy": [
                            {
                              "property": {
                                "type": "string"
                              },
                              "type": "groupBy"
                            }
                          ],
                          "limit": 50
                        }
                      }
                    },
                    "refId": "A",
                    "hidden": false
                  }
                }
              ],
              "transformations": [],
              "queryOptions": {}
            }
          },
          "vizConfig": {
