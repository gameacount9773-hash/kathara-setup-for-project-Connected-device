      "panel-2": {
        "kind": "Panel",
        "spec": {
          "id": 2,
          "title": "Latest alarms",
          "description": "Warnings and alarms raised by the edge gateway, newest first. Threshold = the limit that was crossed at that moment.",
          "links": [],
          "data": {
            "kind": "QueryGroup",
            "spec": {
              "queries": [
                {
                  "kind": "PanelQuery",
                  "spec": {
                    "query": {
                      "kind": "DataQuery",
                      "group": "grafana-postgresql-datasource",
                      "version": "v0",
                      "datasource": {
                        "name": "factory-postgres-ds"
                      },
                      "spec": {
                        "dataset": "factory_db",
                        "editorMode": "code",
                        "format": "table",
                        "rawQuery": true,
                        "rawSql": "SELECT alarm.time, sensor.name AS sensor, alarm.level, alarm.value, alarm.threshold\r\nFROM alarm\r\nJOIN sensor ON sensor.sensor_id = alarm.sensor_id\r\nWHERE $__timeFilter(alarm.time)\r\nORDER BY alarm.time DESC\r\nLIMIT 50",
                        "sql": {
                          "columns": [
