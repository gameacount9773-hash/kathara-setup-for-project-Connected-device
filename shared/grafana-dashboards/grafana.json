      "panel-1": {
        "kind": "Panel",
        "spec": {
          "id": 1,
          "title": "Temperature",
          "description": "Live temperature, averaged per 5 s. Yellow line = warning (45 °C), red line = alarm (60 °C).",
          "links": [],
          "data": {
            "kind": "QueryGroup",
            "spec": {
              "queries": [
                {
                  "kind": "PanelQuery",
                  "spec": {
                    "query": {
                      "kind": "DataQuery",
                      "group": "grafana-postgresql-datasource",
                      "version": "v0",
                      "datasource": {
                        "name": "factory-postgres-ds"
                      },
                      "spec": {
                        "dataset": "factory_db",
                        "editorMode": "code",
                        "format": "time_series",
                        "rawQuery": true,
                        "rawSql": "SELECT $__timeGroupAlias(measurement.time, '5s'),\r\n       sensor.name AS metric,\r\n       avg(measurement.value) AS value\r\nFROM measurement\r\nJOIN sensor      ON sensor.sensor_id    = measurement.sensor_id\r\nJOIN sensor_type ON sensor_type.type_id = sensor.type_id\r\nWHERE $__timeFilter(measurement.time) AND sensor_type.name = 'Temperature'\r\nGROUP BY 1, 2\r\nORDER BY 1",
                        "sql": {
                          "columns": [
                            {
                              "parameters": [],
                              "type": "function"
                            }
                          ],
                          "groupBy": [
                            {
                              "property": {
                                "type": "string"
                              },
                              "type": "groupBy"
                            }
                          ],
                          "limit": 50
                        }
                      }
                    },
                    "refId": "A",
                    "hidden": false
                  }
                }
              ],
              "transformations": [],
              "queryOptions": {}
            }
          },
