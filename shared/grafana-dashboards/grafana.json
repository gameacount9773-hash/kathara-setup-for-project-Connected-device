      "panel-6": {
        "kind": "Panel",
        "spec": {
          "id": 6,
          "title": "Battery sorting errors",
          "description": "Number of batteries per step and error code. Shows where in the sorting process problems happen",
          "links": [],
          "data": {
            "kind": "QueryGroup",
            "spec": {
              "queries": [
                {
                  "kind": "PanelQuery",
                  "spec": {
                    "query": {
                      "kind": "DataQuery",
                      "group": "grafana-postgresql-datasource",
                      "version": "v0",
                      "datasource": {
                        "name": "factory-postgres-ds"
                      },
                      "spec": {
                        "dataset": "factory_db",
                        "editorMode": "code",
                        "format": "table",
                        "rawQuery": true,
                        "rawSql": "SELECT battery_event.step || ' – ' || battery_event.error_code AS problem,\r\n       count(*) AS batteries\r\nFROM battery_event\r\nWHERE battery_event.error_code IS NOT NULL AND $__timeFilter(battery_event.time)\r\nGROUP BY 1\r\nORDER BY 2 DESC",
