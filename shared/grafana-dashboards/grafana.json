      "panel-4": {
        "kind": "Panel",
        "spec": {
          "id": 4,
          "title": "Message delivery (%)",
          "description": "Share of messages that reached the database, based on gaps in the sequence numbers.",
          "links": [],
          "data": {
            "kind": "QueryGroup",
            "spec": {
              "queries": [
                {
                  "kind": "PanelQuery",
                  "spec": {
                    "query": {
                      "kind": "DataQuery",
                      "group": "grafana-postgresql-datasource",
                      "version": "v0",
                      "datasource": {
                        "name": "factory-postgres-ds"
                      },
                      "spec": {
                        "dataset": "factory_db",
                        "editorMode": "code",
                        "format": "table",
                        "rawQuery": true,
                        "rawSql": "SELECT sensor.name AS sensor,\r\n       round(100.0 * count(*) / (max(measurement.sequence_number) - min(measurement.sequence_number) + 1), 1) AS delivery_pct\r\nFROM measurement\r\nJOIN sensor ON sensor.sensor_id = measurement.sensor_id\r\nWHERE $__timeFilter(measurement.time)\r\nGROUP BY sensor.name\r\nORDER BY delivery_pct",
                        "sql": {
                          "columns": [
                            {
                              "parameters": [],
                              "type": "function"
                            }
                          ],
                          "groupBy": [
                            {
                              "property": {
                                "type": "string"
                              },
                              "type": "groupBy"
                            }
