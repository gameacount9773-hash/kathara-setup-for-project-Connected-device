      "panel-5": {
        "kind": "Panel",
        "spec": {
          "id": 5,
          "title": "Message delay (ms)",
          "description": "Time between the sensor reading and its arrival in the database. ",
          "links": [],
          "data": {
            "kind": "QueryGroup",
            "spec": {
              "queries": [
                {
                  "kind": "PanelQuery",
                  "spec": {
                    "query": {
                      "kind": "DataQuery",
                      "group": "grafana-postgresql-datasource",
                      "version": "v0",
                      "datasource": {
                        "name": "factory-postgres-ds"
                      },
                      "spec": {
                        "dataset": "factory_db",
                        "editorMode": "code",
                        "format": "table",
                        "rawQuery": true,
                        "rawSql": "SELECT sensor.name AS sensor,\r\n       round(max(extract(epoch FROM measurement.received_at - measurement.time) * 1000)) AS max_delay_ms\r\nFROM measurement\r\nJOIN sensor ON sensor.sensor_id = measurement.sensor_id\r\nWHERE $__timeFilter(measurement.time)\r\nGROUP BY sensor.name\r\nORDER BY max_delay_ms DESC",
                        "sql": {
